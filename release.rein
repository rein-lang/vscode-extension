import { trust_workflow } from "./release/trust_workflow";
import { publish } from "./release/publish";

interface Input {
  /** The path of the local clone of the VS Code extension repo. */
  repo: string;
}

interface Policy {
  /** Does the publisher have an active trusted publishing policy for this
   * repo and publish.yml? */
  policy: "active" | "missing";
}

/**
 * Release the package.json version. A merge to main publishes it, so the
 * merge of the version bump is the user's approval. The Marketplace must
 * trust the workflow first.
 */
export default async function release({ repo }: Input) {
  /** Does the Marketplace trust the publish workflow? */
  const trust: Policy = await request(`Open the Trusted Publishing tab
  of the package.json publisher on the Marketplace manage page. Look for
  an active policy with the owner and repo of ${repo} and the workflow
  publish.yml.`);

  if (trust.policy == "missing") {
    return trust_workflow(repo=repo);
  }

  return publish(repo=repo);
}
