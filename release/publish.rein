interface Input {
  /** The path of the local clone of the VS Code extension repo. */
  repo: string;
}

interface Run {
  /** What did scripts/watch-publish.sh report? */
  result:
    | "published"
    | "not started"
    | "name taken"
    | "auth failed"
    | "other failure";
}

/**
 * Watch the publish run that the merge to main started. A failure leads
 * to its fix. Nothing here pushes a tag or publishes by hand.
 */
export default async function publish({ repo }: Input) {
  /** How did the publish run end? */
  const run: Run = await request(`Run scripts/watch-publish.sh ${repo}
  from this program's folder. It waits for the publish run of the
  default branch head and checks the listing.`);

  switch (run.result) {
    case "published":
      return @../check_install(repo=repo);
    case "not started":
      return askUser(question=`No publish run exists for the head of
      ${repo}. The version in package.json is not on the Marketplace.
      Merge a pull request to main, such as the version bump, to start
      the publish?`);
    case "name taken":
      return @../rename(repo=repo);
    case "auth failed":
      return askUser(question=`The publish run of ${repo} failed to sign
      in to the Marketplace. Owner, repo and workflow file of the trusted
      publishing policy must match. Fix it, then run vscode-extension
      again?`);
    case "other failure":
      return askUser(question=`The publish run of ${repo} failed. Read
      the failed run log with me and fix it?`);
  }
}
